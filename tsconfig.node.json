{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "target": "ES2022",
    "strict": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.config.ts", "tests/**/*.ts", "package.json"]
}
