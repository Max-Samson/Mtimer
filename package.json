{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Danny Smith",
  "copyright": "Copyright \u00a9 2025 Danny Smith. All rights reserved.",
  "license": "MIT",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "typescript-eslint": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build --config src-tauri/tauri.local-build.conf.json",
    "build:frontend": "tsc --noEmit && vite build",
    "build:release": "node scripts/check-release.mjs && tauri build",
    "preview": "vite preview",
    "test": "npm run test:web && npm run test:backend",
    "test:web": "node scripts/test-env.mjs vitest run",
    "test:frontend": "node scripts/test-env.mjs vitest run --project frontend",
    "test:ui": "node scripts/test-env.mjs vitest run --project ui",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "node scripts/test-env.mjs vitest",
    "test:coverage": "node scripts/test-env.mjs vitest run --coverage",
    "test:e2e": "npm run build:e2e && node scripts/test-env.mjs playwright test",
    "build:e2e": "vite build --config vite.e2e.config.ts",
    "check": "npm run check:frontend && npm run check:backend && npm test",
    "check:all": "npm run check",
    "check:frontend": "npm run typecheck && npm run lint && npm run ast:lint && npm run format:check && npm run check:ui",
    "check:backend": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check:ui": "node scripts/check-ui.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ast:lint": "ast-grep scan",
    "ast:fix": "ast-grep scan --fix",
    "bindings:generate": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings -- --ignored --nocapture",
    "release:prepare": "node scripts/prepare-release.js",
    "task:complete": "node scripts/complete-task.js",
    "task:rename-done": "node scripts/complete-task.js --rename-existing",
    "knip": "knip",
    "jscpd": "jscpd",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^25.7.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.0",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.42.3",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jscpd": "^5.4.2",
    "jsdom": "^29.1.1",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5",
    "vitest": "^4.0.15",
    "zod-validation-error": "^4.0.2",
    "@playwright/test": "1.65.0"
  }
}
